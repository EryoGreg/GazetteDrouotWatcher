# to a GitHub Release instead.
build/
dist/
*.spec
GazetteDrouotWatcherGUI.exe

# Per-machine GUI preference (theme/language choice, window position)
gui_prefs.json

# Claude Code's own local tool-permission settings — not part of the project
.claude/
